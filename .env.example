# Copy to .env for local development; .env is ignored by Git and imported by Spring.
# Production: inject environment variables through the deployment secret store.
SPRING_PROFILES_ACTIVE=dev

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=wallet_runtime
SPRING_DATASOURCE_PASSWORD=

# --- JWT (sinh bằng: openssl rand -base64 48) ---
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=86400000

# --- Tài khoản admin khởi tạo (chỉ dùng ở lần chạy đầu, khi bảng users còn trống) ---
ADMIN_INITIAL_PASSWORD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_AVATAR=Avatar_Eco

# --- CORS: danh sách origin của frontend, phân tách bằng dấu phẩy ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Nghiệp vụ ---
APP_ORDER_PENDING_TIMEOUT_MINUTES=15
APP_ORDER_CLEANUP_INTERVAL_MS=60000

# --- Wallet limits (VND); new requests only, retries keep their original reservation ---
WALLET_LIMITS_TOP_UP_PER_TRANSACTION=50000000
WALLET_LIMITS_TOP_UP_PER_DAY=100000000
WALLET_LIMITS_WITHDRAW_PER_TRANSACTION=20000000
WALLET_LIMITS_WITHDRAW_PER_DAY=50000000
WALLET_LIMITS_PAYMENT_PER_TRANSACTION=50000000
WALLET_LIMITS_PAYMENT_PER_DAY=100000000
WALLET_LIMITS_MAX_REQUESTS=10
WALLET_LIMITS_REQUEST_WINDOW=PT10M
WALLET_BANK_CALL_TIMEOUT=PT10S
WALLET_BANK_MAX_CONCURRENT_CALLS=4

# --- Migration account: CI/migration process only; never inject into the running application ---
# Maven reads actual process environment variables, not this .env file.
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=

# --- Optional SMTP recovery delivery ---
WALLET_RECOVERY_EMAIL_ENABLED=false
WALLET_RECOVERY_EMAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=10000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=10000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=10000
