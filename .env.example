# Mẫu biến môi trường. Copy thành .env hoặc export trực tiếp.
# TUYỆT ĐỐI không commit file .env thật lên git.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/ecommerce?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=doi_mat_khau_nay

# --- JWT (sinh bằng: openssl rand -base64 48) ---
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Tài khoản admin khởi tạo (chỉ dùng ở lần chạy đầu) ---
ADMIN_INITIAL_PASSWORD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=Avatar_Eco

# --- CORS: danh sách origin của frontend, phân tách bằng dấu phẩy ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Nghiệp vụ ---
ORDER_PENDING_TIMEOUT_MINUTES=15
ORDER_CLEANUP_INTERVAL_MS=60000
