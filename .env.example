# TÙY CHỌN — chỉ cần khi deploy lên môi trường thật.
#
# Ứng dụng đã chạy được ngay với cấu hình trong src/main/resources/application.properties.
# File này liệt kê các biến môi trường CÓ THỂ dùng để ghi đè cấu hình đó mà không
# phải sửa code (biến môi trường có độ ưu tiên cao hơn application.properties).
#
# Tên biến là dạng viết hoa + gạch dưới của property tương ứng:
#   app.jwt.secret  ->  APP_JWT_SECRET

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=doi_mat_khau_nay

# --- JWT (sinh bằng: openssl rand -base64 48) ---
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=86400000

# --- Tài khoản admin khởi tạo (chỉ dùng ở lần chạy đầu, khi bảng users còn trống) ---
ADMIN_INITIAL_PASSWORD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_AVATAR=Avatar_Eco

# --- CORS: danh sách origin của frontend, phân tách bằng dấu phẩy ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Nghiệp vụ ---
APP_ORDER_PENDING_TIMEOUT_MINUTES=15
APP_ORDER_CLEANUP_INTERVAL_MS=60000
